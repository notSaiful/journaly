{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.journaly.in" }],
      "destination": "https://journaly.in/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.journaly.in" }],
      "destination": "https://journaly.in/$1",
      "permanent": true
    },
    { "source": "/quote", "destination": "/business", "permanent": true },
    { "source": "/shop", "destination": "/customization", "permanent": true },
    { "source": "/shop/:path*", "destination": "/customization", "permanent": true },
    { "source": "/product", "destination": "/customization", "permanent": true },
    { "source": "/product/:path*", "destination": "/customization", "permanent": true },
    { "source": "/collections", "destination": "/customization", "permanent": true },
    { "source": "/collections/:path*", "destination": "/customization", "permanent": true },
    { "source": "/personalise", "destination": "/customization", "permanent": true },
    { "source": "/personalise/:path*", "destination": "/customization", "permanent": true },
    { "source": "/personalize", "destination": "/customization", "permanent": true },
    { "source": "/personalize/:path*", "destination": "/customization", "permanent": true },
    { "source": "/gifts", "destination": "/corporate-gifting", "permanent": true },
    { "source": "/gifts/:path*", "destination": "/corporate-gifting", "permanent": true },
    { "source": "/five-minute-habit", "destination": "/", "permanent": true },
    { "source": "/five-minute-habit/:path*", "destination": "/", "permanent": true },
    { "source": "/track-order", "destination": "/contact", "permanent": true },
    { "source": "/track-order/:path*", "destination": "/contact", "permanent": true },
    { "source": "/order-success", "destination": "/business", "permanent": true },
    { "source": "/order-success/:path*", "destination": "/business", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    }
  ]
}
